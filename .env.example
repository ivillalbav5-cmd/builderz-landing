# WhatsApp y Calendly ya vienen cargados en el archivo `.env` (son datos públicos del sitio).
# Para cambiarlos sin tocar `.env`: crear `.env.local` (no se versiona) o cargarlos en el hosting.
# NO poner secretos acá. NEXT_PUBLIC_* es visible en el navegador: solo datos públicos.
# Todas estas variables se leen al COMPILAR (npm run build): definirlas ANTES del build.

# Contacto (ya están en `.env`; el build falla a propósito si faltan)
NEXT_PUBLIC_WHATSAPP_NUMBER=549XXXXXXXXXX
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tu-usuario/tu-evento

# Indexación en Google: dejar sin definir (o false) en local, Vercel y previews.
# Poner true SOLO en la producción final (www.builderz.ar). Si no, robots.txt bloquea todo.
ALLOW_INDEXING=false

# Opcionales (medición). Vacías = no se carga nada.
# Con tráfico desde España hace falta banner de cookies antes de activarlas.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
